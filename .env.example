# ---------------------------------------------------------------------------
# Обязательное
# ---------------------------------------------------------------------------

# Подпись сессий и шифрование ключей ElevenLabs. Минимум 16 символов.
# Сгенерировать: openssl rand -base64 48
SESSION_SECRET=

# Ключ OpenAI: сценарий, распознавание референса, картинки.
OPENAI_API_KEY=

# Стартовые администраторы через запятую. Их нельзя снять из панели.
ADMIN_EMAILS=you@example.com

# Внешний адрес сайта — попадает в письма.
APP_URL=https://example.com
APP_NAME=AI Video Studio

# ---------------------------------------------------------------------------
# Данные (на сервере — /var/lib/studio, локально можно не задавать)
# ---------------------------------------------------------------------------

DATA_DIR=/var/lib/studio
# DB_PATH=/var/lib/studio/studio.db
# MEDIA_ROOT=/var/lib/studio/media

# Через сколько дней уборщик стирает картинки и звук (текст и стоимость остаются).
MEDIA_TTL_DAYS=30
# Сколько генераций даётся при одобрении заявки.
DEFAULT_GENERATION_LIMIT=5

# ---------------------------------------------------------------------------
# Почта: коды входа и приглашения. Без настройки письма пишутся в журнал сервера.
# ---------------------------------------------------------------------------

MAIL_FROM=AI Video Studio <no-reply@example.com>
# Вариант 1 — Resend (3 000 писем в месяц бесплатно)
RESEND_API_KEY=
# Вариант 2 — SMTP хостера
# SMTP_HOST=smtp.hoster.kz
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_SECURE=0

# ---------------------------------------------------------------------------
# Необязательное
# ---------------------------------------------------------------------------

# Общая заглушка сайта на время теста. Пусто — заглушки нет.
SITE_PASSWORD=
# Запасной ключ ElevenLabs владельца, если у пользователя своего нет.
ELEVENLABS_API_KEY=

# Порт приложения (за nginx).
PORT=3000
HOSTNAME=127.0.0.1
