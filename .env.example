# ---------------------------------------------------------------------------
# Обязательное
# ---------------------------------------------------------------------------

# Подпись сессий и шифрование ключей пользователей (ElevenLabs, OpenAI). Минимум 16 символов.
# Сгенерировать: openssl rand -base64 48
# Смена секрета гасит все сессии и делает нечитаемыми сохранённые ключи пользователей.
SESSION_SECRET=

# Почта главного администратора. Снять его из панели нельзя; остальных
# администраторов он добавляет в панели.
ADMIN_EMAIL=you@example.com

# Код администратора — хранится только scrypt-хэшем, сам код в файлах не лежит.
# Сгенерировать хэш: node scripts/hash-code.mjs "<код>"
ADMIN_CODE_HASH=

# Внешний адрес сайта: с https:// cookie ставятся с флагом Secure.
APP_URL=https://example.com
APP_NAME=AI Video Studio

# ---------------------------------------------------------------------------
# Данные (на сервере — /var/lib/studio, локально можно не задавать)
# ---------------------------------------------------------------------------

DATA_DIR=/var/lib/studio
# DB_PATH=/var/lib/studio/studio.db
# MEDIA_ROOT=/var/lib/studio/media

# Через сколько дней уборщик стирает картинки и звук (текст и стоимость остаются).
MEDIA_TTL_DAYS=30

# ---------------------------------------------------------------------------
# Необязательное
# ---------------------------------------------------------------------------

# Общая заглушка сайта на время теста. Пусто — заглушки нет.
SITE_PASSWORD=

# Порт приложения (за nginx).
PORT=3000
HOSTNAME=127.0.0.1

# Ключей OpenAI и ElevenLabs у сервера нет: каждый пользователь вводит свои
# в студии, все расходы идут с его счетов. ELEVENLABS_API_KEY нужен только
# скрипту scripts/gen-voice-samples.mjs (демо-сэмплы голосов).
# ELEVENLABS_API_KEY=
